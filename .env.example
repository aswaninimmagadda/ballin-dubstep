# ============================================================
# GymFlow environment template.
# Copy to .env (never commit .env). Every variable here must be
# provided per environment (local / staging / production).
# ============================================================

# --- Database ---------------------------------------------------------------
# Superuser/owner URL used ONLY by migrations and seeds (server-side, CI).
DATABASE_URL=postgres://gymflow:gymflow_dev_pw@localhost:5432/gymflow_dev
# Restricted runtime role used by the application. RLS is enforced on this
# role. NEVER point the app at a superuser in production.
DATABASE_APP_URL=postgres://gymflow_app:change_me@localhost:5432/gymflow_dev
# Test database (integration tests). CI creates this.
TEST_DATABASE_URL=postgres://gymflow:gymflow_dev_pw@localhost:5432/gymflow_test

# --- Admin web app ----------------------------------------------------------
# (No session-signing secret is needed: staff session tokens are 256-bit
# random values stored as SHA-256 hashes, so there is no cookie to sign.)
# Public origin of the admin app, e.g. https://admin.example.com
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# Number of reverse proxies in front of the app that append to
# X-Forwarded-For (Caddy/nginx = 1, CDN + Caddy = 2, no proxy = leave unset).
# Unset means per-address login throttling is OFF, on purpose: a limiter fed a
# client-supplied address is bypassable AND can be aimed at a victim.
# See docs/DEPLOYMENT.md.
TRUSTED_PROXY_HOPS=

# --- Member API tokens ------------------------------------------------------
# 32+ byte random secret for member access-token signing (openssl rand -hex 32)
MEMBER_TOKEN_SECRET=

# --- Supabase (only when deploying on Supabase; leave empty for plain PG) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key is SERVER-ONLY. Never ship it in a client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional providers (Phase 2; leave empty to disable) -------------------
SMS_PROVIDER=
SMS_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_KEY_ID=
PAYMENT_KEY_SECRET=
PAYMENT_WEBHOOK_SECRET=
