{
  "name": "gymflow",
  "private": true,
  "version": "0.1.0",
  "description": "GymFlow — multi-tenant gym management platform (working name; see packages/config)",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\" --ignore-path .gitignore",
    "lint": "eslint .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:unit": "pnpm --filter @gymflow/core --filter @gymflow/utils --filter @gymflow/validation --filter @gymflow/i18n test",
    "test:integration": "pnpm --filter @gymflow/database test",
    "build": "pnpm -r --if-present build",
    "db:migrate": "pnpm --filter @gymflow/database migrate",
    "db:seed": "pnpm --filter @gymflow/database seed",
    "db:reset": "pnpm --filter @gymflow/database reset",
    "dev:admin": "pnpm --filter @gymflow/admin dev",
    "dev:member": "pnpm --filter @gymflow/member start"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.67.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.10": "^8.5.10",
      "sharp@<0.35.4": "^0.35.4",
      "@xmldom/xmldom@>=0.9.0 <0.9.12": "^0.9.12",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "uuid@<11.1.1": "^11.1.1",
      "@xmldom/xmldom@>=0.7.0 <0.8.15": "^0.8.15"
    }
  }
}
