{
  "cli": { "version": ">= 5.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "GYMFLOW_API_URL": "http://192.168.1.4:3000" }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "ios": { "simulator": false },
      "env": { "GYMFLOW_API_URL": "http://192.168.1.4:3000" }
    },
    "production": {
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" },
      "env": { "GYMFLOW_API_URL": "https://admin.example.in" }
    }
  },
  "submit": { "production": {} }
}
