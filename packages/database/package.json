{
  "name": "@gymflow/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "tsx scripts/migrate.ts",
    "seed": "tsx scripts/seed.ts",
    "reset": "tsx scripts/reset.ts",
    "sweep": "tsx scripts/sweep-memberships.ts",
    "create-tenant": "tsx scripts/create-tenant.mjs",
    "test": "vitest run --pool=forks --poolOptions.forks.singleFork",
    "reset-staff-password": "tsx scripts/reset-staff-password.mjs",
    "manage-tenant": "tsx scripts/manage-tenant.mjs"
  },
  "dependencies": {
    "@gymflow/core": "workspace:*",
    "@gymflow/types": "workspace:*",
    "@gymflow/utils": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
